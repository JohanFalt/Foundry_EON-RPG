<section class="tab {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
    <div class="item-row motstandare-fardigheter-row">
            <div class="item-box skill-area three-column">
                <div class="item-row headline item-listrow">
                    <div class="item-listbox weapon-icon">
                        <a data-action="pickFardighet" title="{{localize 'eon.sheets.actor.laggTillFardighet'}}">
                            <i class="fa-solid fa-square-plus green"></i>
                        </a>
                    </div>
                    <div class="item-listbox skill-headline headline">{{localize "eon.sheets.actor.fardigheter"}}</div>
                </div>

                {{#each listdata.fardigheterStandard as |fardighet|}}
                    <div class="skill-row skill">
                        <div>
                            {{#if fardighet.system.installningar.lattlard}}
                                <div style="width: 8px;position: relative;top: 1px;"><i class="fa-solid fa-sort-up green"></i></div>
                            {{/if}}
                            {{#if fardighet.system.installningar.svarlard}}
                                <div style="width: 8px;position: relative;top: -4px;"><i class="fa-solid fa-sort-down red"></i></div>
                            {{/if}}
                        </div>
                        <div class="vrollable caption normalskill" data-action="rollDialog" data-type="fardighet" data-item-id="{{fardighet._id}}">{{localize fardighet.name}}</div>
                        <div class="dice-value">{{getDiceValue fardighet.system.varde}}</div>
                        <div class="skill-markers">{{skillDisplayShort fardighet}}</div>
                        <div class="pointer skill-icon">
                            <a data-action="itemEdit" data-item-id="{{fardighet._id}}" title="{{localize 'eon.sheets.actor.editeraFardighet'}}">
                                <i class="icon fa-solid fa-pen-to-square"></i>
                            </a>
                        </div>
                    </div>
                {{/each}}
            </div>

            <div class="item-box skill-area three-column">
                <div class="item-row headline item-listrow">
                    <div class="item-listbox weapon-icon">
                        <a data-action="itemCreate" data-type="färdighet" data-subtype="sprak" title="{{localize 'eon.sheets.actor.laggTillFardighet'}}">
                            <i class="fa-solid fa-square-plus green"></i>
                        </a>
                    </div>
                    <div class="item-listbox skill-headline headline">{{localize "eon.config.fardighetgrupper.sprak"}}</div>
                </div>

                {{#each listdata.fardigheter.sprak as |fardighet|}}
                    <div class="skill-row skill skill-row-sprak">
                        <div></div>
                        <div class="caption normalskill">{{localize fardighet.name}}</div>
                        <div class="resource-box">
                            <span class="resource-value {{#if fardighet.system.talabrytning}}active{{/if}} {{#if fardighet.system.endastskrift}}disabled{{/if}}" data-action="toggleSprakField" data-item-id="{{fardighet._id}}" data-field="talabrytning" title="{{localize 'eon.sheets.actor.talarMedBrytning'}}"></span>
                            <span class="resource-value {{#if fardighet.system.talaflytande}}active{{/if}} {{#if fardighet.system.endastskrift}}disabled{{/if}}" data-action="toggleSprakField" data-item-id="{{fardighet._id}}" data-field="talaflytande" title="{{localize 'eon.sheets.actor.talarFlytande'}}"></span>
                            <span class="resource-value {{#if fardighet.system.lasaskriva}}active{{/if}} {{#if fardighet.system.endasttal}}disabled{{/if}}" data-action="toggleSprakField" data-item-id="{{fardighet._id}}" data-field="lasaskriva" title="{{localize 'eon.sheets.actor.kanLasaochSkriva'}}"></span>
                        </div>
                        <div></div>
                        <div class="pointer skill-icon">
                            <a data-action="itemEdit" data-item-id="{{fardighet._id}}" title="{{localize 'eon.sheets.actor.editeraSprak'}}">
                                <i class="icon fa-solid fa-pen-to-square"></i>
                            </a>
                        </div>
                    </div>
                {{/each}}
            </div>

            <div class="item-box skill-area three-column">
                <div class="item-row headline item-listrow">
                    <div class="item-listbox weapon-icon">
                        <a data-action="itemCreate" data-type="färdighet" data-subtype="ovriga" title="{{localize 'eon.sheets.actor.laggTillFardighet'}}">
                            <i class="fa-solid fa-square-plus green"></i>
                        </a>
                    </div>
                    <div class="item-listbox skill-headline headline">{{localize "eon.config.fardighetgrupper.ovriga"}}</div>
                </div>

                {{#each listdata.fardigheter.ovriga as |fardighet|}}
                    <div class="skill-row skill">
                        <div>
                            {{#if fardighet.system.installningar.lattlard}}
                                <div style="width: 8px;position: relative;top: 1px;"><i class="fa-solid fa-sort-up green"></i></div>
                            {{/if}}
                            {{#if fardighet.system.installningar.svarlard}}
                                <div style="width: 8px;position: relative;top: -4px;"><i class="fa-solid fa-sort-down red"></i></div>
                            {{/if}}
                        </div>
                        <div class="vrollable caption normalskill" data-action="rollDialog" data-type="fardighet" data-item-id="{{fardighet._id}}">{{localize fardighet.name}}</div>
                        <div class="dice-value">{{getDiceValue fardighet.system.varde}}</div>
                        <div class="skill-markers">{{skillDisplayShort fardighet}}</div>
                        <div class="pointer skill-icon">
                            <a data-action="itemEdit" data-item-id="{{fardighet._id}}" title="{{localize 'eon.sheets.actor.editeraFardighet'}}">
                                <i class="icon fa-solid fa-pen-to-square"></i>
                            </a>
                        </div>
                    </div>
                {{/each}}
            </div>
        </div>
</section>
